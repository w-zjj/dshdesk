{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.0",
  "identifier": "com.deepseek.harness",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "url": "index.html",
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/dsh-bundle", "resources/node-portable"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
